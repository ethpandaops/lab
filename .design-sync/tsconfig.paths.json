        "src/constants/index"
      ],
      "@/routes": [
        "src/routes/index"
      ],
      "@/utils": [
        "src/utils/index"
      ],
      "@/api": [
        "src/api/index"
      ],
      "@/*": [
        "src/*"
      ]
    }
  }
}
