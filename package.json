{
  "name": "lab",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode production",
    "preview": "vite preview",
    "test": "VITEST_CHROMIUM_GC_DISK_THRESHOLD_GB=1000000 vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:storybook": "VITEST_CHROMIUM_GC_DISK_THRESHOLD_GB=1000000 vitest run --project storybook",
    "test:storybook:watch": "VITEST_CHROMIUM_GC_DISK_THRESHOLD_GB=1000000 vitest --project storybook",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --project unit --coverage",
    "lint": "eslint . --max-warnings 0 --cache --cache-location node_modules/.cache/eslint",
    "typecheck": "tsc -b",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist node_modules",
    "generate:api": "openapi-ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "build-storybook:gh-pages": "STORYBOOK_BASE_PATH=/lab storybook build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.2.10",
    "@headlessui/react": "2.2.9",
    "@heroicons/react": "2.2.0",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.159.5",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/router-plugin": "1.159.5",
    "clsx": "2.1.1",
    "country-flag-icons": "1.6.20",
    "culori": "4.0.2",
    "echarts": "6.0.0",
    "echarts-for-react": "3.0.6",
    "echarts-gl": "2.0.9",
    "html-to-image": "1.11.13",
    "react": "19.2.4",
    "react-datepicker": "9.1.0",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.0.1",
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.92.3",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-themes": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/builder-vite": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/forms": "0.5.11",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/culori": "4.0.1",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "@vitest/ui": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "10.6.6",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "knip": "6.44.2",
    "msw": "3.0.4",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.65.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rollup-plugin-visualizer": "6.0.5",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  },
  "volta": {
    "node": "26.13.0",
    "pnpm": "12.18.0"
  },
  "types": ".design-sync/ds-entry.ts"
}
